# =========================================================================
# Oliver CRM — variáveis de ambiente do FRONTEND (prefixo VITE_)
# -------------------------------------------------------------------------
# Copie este arquivo para `.env` no desenvolvimento local.
# Na Vercel: Project → Settings → Environment Variables (cadastre os mesmos
# nomes nos ambientes Production, Preview e Development).
#
# ATENÇÃO: tudo que tem prefixo VITE_ é embutido no bundle e fica VISÍVEL
# no navegador. Nunca coloque segredos de servidor (service_role, chaves
# privadas de IA, tokens de webhook) aqui — esses ficam no Supabase.
# =========================================================================

# --- Supabase (obrigatório) ---
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# A "publishable/anon key" do Supabase. Os dois nomes abaixo recebem o MESMO
# valor (há dois clients no código usando nomes diferentes).
VITE_SUPABASE_PUBLISHABLE_KEY=sua-anon-key-publica
VITE_SUPABASE_ANON_KEY=sua-anon-key-publica

# --- UTMify (rastreamento de conversões — opcional) ---
VITE_UTMIFY_WEBHOOK_URL=

# Aba CRM (pipeline de oportunidades, leads e tarefas).
# LIGADA por padrão: o CRM funciona sobre as tabelas que já existem (clientes,
# alertas, fachada_leads) e fica mais rico depois da migration crm-module.sql.
# Para desligar e voltar ao Funil de Vendas clássico: VITE_CRM_ENABLED=false.
# Esconde a interface, não protege dado: o isolamento é a RLS no Supabase.
VITE_CRM_ENABLED=true

# =========================================================================
# Segredos do BACKEND (Supabase Edge Functions) — NÃO vão aqui.
# Configure-os com `supabase secrets set` ou no Dashboard do Supabase:
#   GROK_API_KEY            -> IA (assistente, contratos, WhatsApp)
#   GEMINI_API_KEY          -> análise de fotos (Edge Function analisar-foto)
#   SUPABASE_SERVICE_ROLE_KEY
#   ASAAS_WEBHOOK_TOKEN     -> webhook de pagamentos Asaas
#   N8N_SHARED_SECRET       -> integração n8n
# (LOVABLE_API_KEY foi REMOVIDA — não é mais necessária.)
# =========================================================================

# Login social. VAZIO por padrão — o botão só aparece depois que o provedor
# estiver configurado no painel do Supabase (passo a passo em infra/OAUTH.md).
# Ligar sem configurar produz um botão que só devolve "Unsupported provider".
# Valores aceitos: google, microsoft (separados por vírgula).
VITE_OAUTH_PROVIDERS=

# =========================================================================
# Back office administrativo (docs/BACKOFFICE.md)
# =========================================================================

# Dominio usado nos links exclusivos de parceiro (/r/slug) e nos QR das
# fachadas. Sem ela, o codigo cai no dominio de producao embutido — o que
# evita gerar link com "localhost", mas e melhor ser explicito.
VITE_PUBLIC_BASE_URL=

# Segredos das Edge Functions de parceiro — NAO vao aqui, use
# `supabase secrets set`:
#   PARCEIRO_ORIGENS_PERMITIDAS -> origens aceitas no CORS de parceiro-clique
#                                  e parceiro-atribuir (separadas por virgula).
#                                  Vazio = qualquer origem. Defina em producao.
#   IP_HASH_SALT                -> salt do hash de IP nos cliques de parceiro.
#                                  Sem ela, usa a service role key como salt.
