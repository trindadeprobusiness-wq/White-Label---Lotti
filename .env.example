# =========================================================================
# Oliver CRM — variáveis de ambiente do FRONTEND (prefixo VITE_)
# -------------------------------------------------------------------------
# Copie este arquivo para `.env` no desenvolvimento local.
# Na Vercel: Project → Settings → Environment Variables (cadastre os mesmos
# nomes nos ambientes Production, Preview e Development).
#
# ATENÇÃO: tudo que tem prefixo VITE_ é embutido no bundle e fica VISÍVEL
# no navegador. Nunca coloque segredos de servidor (service_role, chaves
# privadas de IA, tokens de webhook) aqui — esses ficam no Supabase.
# =========================================================================

# --- Supabase (obrigatório) ---
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# A "publishable/anon key" do Supabase. Os dois nomes abaixo recebem o MESMO
# valor (há dois clients no código usando nomes diferentes).
VITE_SUPABASE_PUBLISHABLE_KEY=sua-anon-key-publica
VITE_SUPABASE_ANON_KEY=sua-anon-key-publica

# Diagnóstico de Crescimento público: reutiliza somente as variáveis VITE_* acima.
# Chaves de IA, serviço e e-mail ficam nos secrets das Edge Functions do Supabase.

# --- UTMify (rastreamento de conversões — opcional) ---
VITE_UTMIFY_WEBHOOK_URL=

# Aba CRM (pipeline de oportunidades, leads e tarefas).
# LIGADA por padrão: o CRM funciona sobre as tabelas que já existem (clientes,
# alertas, fachada_leads) e fica mais rico depois da migration crm-module.sql.
# Para desligar e voltar ao Funil de Vendas clássico: VITE_CRM_ENABLED=false.
# Esconde a interface, não protege dado: o isolamento é a RLS no Supabase.
VITE_CRM_ENABLED=true

# =========================================================================
# Segredos do BACKEND (Supabase Edge Functions) — NÃO vão aqui.
# Configure-os com `supabase secrets set` ou no Dashboard do Supabase:
#   GEMINI_API_KEY          -> Lotti AI Gateway (assistente, contratos, fotos, WhatsApp)
#   LOTTI_AI_FAST_MODEL     -> opcional; padrão central: gemini-2.5-flash
#   LOTTI_AI_INPUT_USD_PER_MTOK  -> estimativa; padrão 0.30 USD / 1M tokens
#   LOTTI_AI_OUTPUT_USD_PER_MTOK -> estimativa; padrão 2.50 USD / 1M tokens
#   SUPABASE_SERVICE_ROLE_KEY
#   GOOGLE_CALENDAR_CLIENT_ID       -> OAuth exclusivo da sincronização da agenda
#   GOOGLE_CALENDAR_CLIENT_SECRET   -> nunca expor no frontend
#   GOOGLE_TOKEN_ENCRYPTION_KEY     -> 32 bytes em base64 ou 64 caracteres hex
#   GOOGLE_CALENDAR_REDIRECT_URI    -> callback da Edge Function de OAuth
#   GOOGLE_CALENDAR_WEBHOOK_URL     -> URL HTTPS pública do webhook do Calendar
#   GOOGLE_CALENDAR_APP_REDIRECT_URL -> retorno para /configuracoes?tab=agenda
#   ROUTINE_INTERNAL_SECRET         -> autentica cron, webhook e sync internos
#   ASAAS_WEBHOOK_TOKEN     -> webhook de pagamentos Asaas (caminho legado, sem ?t=)
#   ASAAS_TOKEN_ENCRYPTION_KEY -> 32 bytes (64 hex ou base64) que cifram a chave
#                              Asaas de CADA inquilino. Precisa ser DIFERENTE de
#                              META_TOKEN_ENCRYPTION_KEY: chave compartilhada
#                              entre integrações transforma o vazamento de uma
#                              no vazamento de todas.
#                              Gerar com: openssl rand -hex 32
#   ASAAS_API_KEY           -> chave da conta-mãe. Continua valendo SÓ para o
#                              inquilino marcado como herdado no banco; os demais
#                              conectam a própria conta pelo produto. Remover
#                              assim que a conta herdada rotacionar a chave.
#   ASAAS_PERMITIR_CHAVE_GLOBAL -> "true" religa a chave global para TODOS.
#                              Válvula de reversão, nasce desligada. Ligar reabre
#                              o vazamento entre inquilinos — use só para
#                              emergência e desligue em seguida.
#   N8N_SHARED_SECRET       -> integração n8n
# (LOVABLE_API_KEY foi REMOVIDA — não é mais necessária.)
# =========================================================================

# O login Google faz parte fixa da interface e precisa estar habilitado no
# Supabase (passo a passo em infra/OAUTH.md). Esta variável controla somente
# provedores sociais adicionais. Valor aceito atualmente: microsoft.
VITE_OAUTH_PROVIDERS=

# =========================================================================
# Back office administrativo (docs/BACKOFFICE.md)
# =========================================================================

# Dominio usado nos links exclusivos de parceiro (/r/slug) e nos QR das
# fachadas. Sem ela, o codigo cai no dominio de producao embutido — o que
# evita gerar link com "localhost", mas e melhor ser explicito.
VITE_PUBLIC_BASE_URL=

# Segredos das Edge Functions de parceiro — NAO vao aqui, use
# `supabase secrets set`:
#   PARCEIRO_ORIGENS_PERMITIDAS -> origens aceitas no CORS de parceiro-clique
#                                  e parceiro-atribuir (separadas por virgula).
#                                  Vazio = qualquer origem. Defina em producao.
#   IP_HASH_SALT                -> salt do hash de IP nos cliques de parceiro.
#                                  Sem ela, usa a service role key como salt.

# API Lotti (Railway). Ex.: https://api-production-7ff5.up.railway.app
VITE_API_URL=
