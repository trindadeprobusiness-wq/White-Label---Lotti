# Equivalente ao vercel.json. O Railway entrega HTTPS; aqui só HTTP na porta $PORT.
{
	admin off
	auto_https off
}

:{$PORT:8080} {
	root * /srv
	encode zstd gzip

	# Callback do Google Agenda vai para a Edge Function no Supabase.
	handle /google-agenda/callback {
		header Cache-Control "no-store"
		rewrite * /functions/v1/google-calendar-auth/callback
		reverse_proxy {$SUPABASE_FUNCTIONS_ORIGIN:https://dqlolypbmsjgqrvdesev.supabase.co} {
			header_up Host {upstream_hostport}
		}
	}

	header {
		Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://www.clarity.ms https://scripts.clarity.ms; script-src-attr 'none'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' https: data: blob:; media-src 'self' https: blob:; connect-src 'self' https: wss://*.supabase.co; worker-src 'self' blob:; frame-src 'self' https://*.supabase.co blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self'; upgrade-insecure-requests"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), browsing-topics=()"
	}

	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# SPA: qualquer rota que não seja arquivo cai no index.html.
	handle {
		try_files {path} /index.html
		file_server
	}
}
